function recalcularDevolucionVoc(){
  const manual = document.getElementById('h-manual');
  if(!manual) return;
  const scores = {};
  RIASEC_KEYS.forEach(k=> scores[k] = clamp(document.getElementById('h-'+k).value || 0, 0, 100));
  document.getElementById('h-codigo').value = codigoRiasec(scores);
  if(!manual.checked){
    const dev = calcularDevolucion3Areas(scores);
    document.getElementById('h-dev-sociales').value = dev.sociales;
    document.getElementById('h-dev-naturales').value = dev.naturales;
    document.getElementById('h-dev-economicas').value = dev.economicas;
  }
}
function toggleDevolucionManualVoc(){
  const manual = document.getElementById('h-manual').checked;
  ['h-dev-sociales','h-dev-naturales','h-dev-economicas'].forEach(id=>{
    document.getElementById(id).readOnly = !manual;
  });
  if(!manual) recalcularDevolucionVoc();
}

async function eliminarRegistroVoc(alumnoId, anioEscolar){
  confirmar('Eliminar registro anual', `¿Confirmás eliminar el registro de ${ordinal(anioEscolar)} año? Esta acción no se puede deshacer.`, async ()=>{
    const al = getAlumno(alumnoId);
    al.trayectoria = al.trayectoria.filter(t=>t.anioEscolar!==anioEscolar);
    await guardarAlumno(al);
    renderVistaAlumno();
    toast('Registro eliminado.');
  });
}

async function guardarRegistroVoc(alumnoId){
  const al = getAlumno(alumnoId);
  const anio = Number(document.getElementById('reg-anio').value);
  const ciclo = Number(document.getElementById('reg-ciclo').value) || null;
  const division = document.getElementById('reg-division').value.trim();
  let orientacion = '';
  if(anio>=4){
    orientacion = document.getElementById('reg-orientacion').value;
    if(orientacion==='Otra') orientacion = document.getElementById('reg-orientacion-custom').value.trim();
  }
  const materias = document.getElementById('reg-materias').value.trim();
  const carreras = document.getElementById('reg-carreras').value.trim();
  const definicion = document.getElementById('reg-definicion').value;
  const obs = document.getElementById('reg-obs').value.trim();

  const tipoTest = document.getElementById('reg-tipotest').value;
  let test = {tipo:null};
  if(tipoTest==='holland'){
    const scores = {};
    RIASEC_KEYS.forEach(k=> scores[k] = clamp(document.getElementById('h-'+k).value || 0, 0, 100));
    const algunCargado = Object.values(scores).some(v=>v>0);
    if(algunCargado){
      const manual = document.getElementById('h-manual').checked;
      const dev = manual
        ? {sociales:clamp(document.getElementById('h-dev-sociales').value,0,100), naturales:clamp(document.getElementById('h-dev-naturales').value,0,100), economicas:clamp(document.getElementById('h-dev-economicas').value,0,100)}
        : calcularDevolucion3Areas(scores);
      test = {tipo:'holland', holland:{...scores, codigo:codigoRiasec(scores), devolucion3Areas:dev, devolucionManual:manual, fuente:document.getElementById('h-fuente').value.trim()}};
    }
  } else {
    const intereses = {}; Object.keys(SOVI_INTERESES_LABELS).forEach(k=> intereses[k]=clamp(document.getElementById('s-int-'+k).value||0,0,100));
    const habilidades = {}; Object.keys(SOVI_HABILIDADES_LABELS).forEach(k=> habilidades[k]=clamp(document.getElementById('s-hab-'+k).value||0,0,100));
    const algoCargado = Object.values(intereses).some(v=>v>0) || Object.values(habilidades).some(v=>v>0);
    if(algoCargado){
      test = {tipo:'sovi', sovi:{intereses, habilidades, fuente: document.getElementById('s-fuente').value.trim()}};
    }
  }

  const registro = {
    id: uid('reg'), anioEscolar:anio, cicloLectivo:ciclo, division,
    orientacionCurricular:orientacion, materiasAfinidad:materias, carrerasInteres:carreras,
    nivelDefinicion:definicion, observaciones:obs, fechaRegistro:new Date().toISOString(), test
  };

  const idx = al.trayectoria.findIndex(t=>t.anioEscolar===anio);
  if(idx>=0) al.trayectoria[idx] = {...al.trayectoria[idx], ...registro, id:al.trayectoria[idx].id};
  else al.trayectoria.push(registro);

  await guardarAlumno(al);
  cerrarModal('modal-generico');
  currentSubTabVoc = 'trayectoria';
  renderVistaAlumno();
  toast('Registro guardado en la trayectoria vocacional.');
}

/* ---------- SUB-TAB: CARRERAS COMPATIBLES ---------- */
function renderVocCarrerasCompatibles(al){
  const match = matchCarreras(al, 10);
  if(!match.origen){
    return '<div class="empty-state">Todavía no se cargó ningún test vocacional para este estudiante. Cargá un registro anual con test de Holland o SOVI para ver carreras compatibles.</div>';
  }
  let html = `<p style="color:var(--text-light);font-size:0.85rem;">Comparación calculada a partir del perfil vocacional de ${ordinal(match.origen.origenAnio)} año (${match.origen.origenTipo==='holland'?'test Holland/RIASEC':'test SOVI-3, convertido a un perfil RIASEC aproximado'}) contra la base de carreras (sección "Base de carreras", dentro de Configuración). Es orientativo, no una indicación exacta.</p>`;
  match.resultados.forEach(m=>{
    html += `
    <div class="career-card">
      <div>
        <div class="cname">${escapeHtml(m.carrera.nombre)}</div>
        <div class="cinst">${escapeHtml((m.carrera.instituciones||[]).join(' · '))}</div>
      </div>
      <div class="match-badge">${m.porcentaje}%</div>
    </div>`;
  });
  return html;
}

