async function guardarEncuestaClima(){
  const curso = cursosDisponibles().find(c=>c.key===cursoSeleccionadoClima);
  const fecha = document.getElementById('clima-fecha').value || new Date().toISOString().slice(0,10);
  const cantidadRespuestas = clamp(document.getElementById('clima-cantidad').value, 1, 9999);
  const tipo = document.getElementById('clima-tipo').value;
  const promedios = {};
  if(tipo==='perma' || tipo==='ambas'){
    Object.keys(PERMA_DIMENSIONES).forEach(k=>{ promedios[k] = Number(document.getElementById(`clima-dim-${k}`).value); });
  }
  if(tipo==='ministerio' || tipo==='ambas'){
    Object.keys(COMPETENCIAS_MINISTERIO).forEach(k=>{ promedios[k] = Number(document.getElementById(`clima-dim-${k}`).value); });
  }
  const observaciones = document.getElementById('clima-observaciones').value.trim();
  const valores = Object.values(promedios);
  const promedioGeneral = valores.length ? round2(promedio(valores)) : null;
  const clima = {
    id: uid('clima'), fecha, creadoEn: Date.now(), cursoKey: cursoSeleccionadoClima,
    nivel: curso.nivel, anio: curso.anio, division: curso.division, cursoLabel: curso.label,
    tipo, cantidadRespuestas, promedios, promedioGeneral,
    nivelGeneral: promedioGeneral!==null ? nivelBienestar(promedioGeneral) : null, observaciones
  };
  AppState.climaEncuestas.push(clima);
  await guardarClimaEncuesta(clima);
  document.getElementById('clima-form-container').innerHTML = '';
  renderPanelClima();
  toast('Encuesta de clima guardada.');
}

