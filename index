function renderBackupBanner(){
  const banner = document.getElementById('backup-banner');
  const ultimo = AppState.config.ultimoRespaldo;
  let dias = ultimo ? Math.floor((Date.now() - new Date(ultimo).getTime())/86400000) : null;
  let clase = 'banner-danger', texto = '⚠️ Todavía no exportaste ningún respaldo de esta computadora.';
  if(dias !== null){
    if(dias <= 14){ clase='banner-ok'; texto = `✅ Último respaldo hace ${dias} día(s) (${new Date(ultimo).toLocaleDateString('es-AR')}).`; }
    else if(dias <= 30){ clase='banner-warn'; texto = `⚠️ Último respaldo hace ${dias} días. Te conviene exportar uno nuevo pronto.`; }
    else { clase='banner-danger'; texto = `⛔ Último respaldo hace ${dias} días. Exportá un respaldo cuanto antes.`; }
  }
  banner.className = 'backup-banner no-print ' + clase;
  banner.innerHTML = `${texto} <button class="btn btn-outline" style="background:#fff;" onclick="irASeccion('config')">Ir a exportar/importar</button>`;
}

