// Redimensiona la foto a un máximo de 220px de ancho/alto antes de guardarla,
// para no ocupar espacio de más (pensado para colegios con muchos estudiantes).
function subirFoto(id, evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    const img = new Image();
    img.onload = async ()=>{
      const max = 220;
      let w = img.width, h = img.height;
      if(w>h && w>max){ h = Math.round(h*max/w); w = max; }
      else if(h>=w && h>max){ w = Math.round(w*max/h); h = max; }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img,0,0,w,h);
      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      const al = getAlumno(id);
      al.fotoBase64 = dataUrl;
      await guardarAlumno(al);
      renderizarListaAlumnos();
      renderVistaAlumno();
      toast('Foto actualizada.');
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

async function quitarFoto(id){
  const al = getAlumno(id);
  al.fotoBase64 = null;
  await guardarAlumno(al);
  renderizarListaAlumnos();
  renderVistaAlumno();
}

