// Última toma de clima registrada para un curso (según fecha, con desempate por hora
// de creación), o null si el curso todavía no tiene ninguna encuesta cargada.
function ultimaClimaDeCurso(cursoKeyVal){
  const lista = AppState.climaEncuestas.filter(c=>c.cursoKey===cursoKeyVal)
    .sort((a,b)=> (new Date(b.fecha)-new Date(a.fecha)) || ((b.creadoEn||0)-(a.creadoEn||0)));
  return lista[0] || null;
}

// Grilla comparativa: todos los cursos con estudiantes activos, agrupados por nivel,
// mostrando el bienestar general (Alto/Medio/Bajo) de su última toma de clima — para
// detectar de un vistazo qué curso necesita más atención.
function renderMapaConsolidadoClima(){
  const cursos = cursosDisponibles();
  const porNivel = {};
  NIVELES.forEach(n=> porNivel[n] = []);
  cursos.forEach(c=>{ if(porNivel[c.nivel]) porNivel[c.nivel].push(c); });

  const coloresPorNivelGeneral = {
    Alto: {fondo:'var(--ok-bg)', borde:'var(--ok-border)'},
    Medio: {fondo:'var(--warning-bg)', borde:'#f1d9a8'},
    Bajo: {fondo:'var(--danger-bg)', borde:'#f2c6c1'}
  };

  return `
    <p style="font-size:0.85rem;color:var(--text-light);margin-bottom:16px;">Última toma de clima registrada en cada curso, agrupada por nivel. Hacé clic en un curso para ver su detalle. Los cursos en gris todavía no tienen ninguna encuesta cargada.</p>
    ${NIVELES.map(nivel=>{
      const lista = porNivel[nivel];
      if(!lista.length) return '';
      return `
        <h3>${nivel}</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-bottom:26px;">
          ${lista.map(c=>{
            const ultima = ultimaClimaDeCurso(c.key);
            if(!ultima){
              return `<div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:#f7f8fc;cursor:pointer;" onclick="irADetalleClimaCurso('${c.key}')">
                <strong>${escapeHtml(c.label)}</strong>
                <div style="margin-top:8px;color:var(--text-light);font-size:0.8rem;">Sin datos todavía</div>
              </div>`;
            }
            const col = coloresPorNivelGeneral[ultima.nivelGeneral] || {fondo:'#f7f8fc', borde:'var(--border)'};
