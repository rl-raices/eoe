/* =========================================================================
   10. IMPORTACIÓN DE ESTUDIANTES (CSV multi-nivel)
   ========================================================================= */

// Preferimos punto y coma si aparece en el archivo: es el formato que usa Excel en
// Argentina por defecto y evita que un nombre "Apellido, Nombre" (con coma adentro)
// rompa la separación de columnas.
function detectarDelimitadorCSV(texto){
  const cantPuntoYComa = (texto.match(/;/g)||[]).length;
  return cantPuntoYComa > 0 ? ';' : ',';
}

function parseLineaCSV(linea, delim){
  const campos = [];
  let actual = '';
  let dentroComillas = false;
  for(let i=0;i<linea.length;i++){
    const ch = linea[i];
    if(dentroComillas){
      if(ch === '"'){
        if(linea[i+1] === '"'){ actual += '"'; i++; }
        else dentroComillas = false;
      } else actual += ch;
    } else {
      if(ch === '"') dentroComillas = true;
      else if(ch === delim){ campos.push(actual.trim()); actual=''; }
      else actual += ch;
    }
  }
  campos.push(actual.trim());
  return campos;
}

// Normaliza el nivel escrito en el CSV a uno de los 3 valores válidos del sistema.
function normalizarNivel(txt){
  const t = (txt||'').trim().toLowerCase();
  if(!t) return 'Secundaria';
  if(t.startsWith('inic')) return 'Inicial';
  if(t.startsWith('prim')) return 'Primaria';
  if(t.startsWith('sec')) return 'Secundaria';
  return 'Secundaria';
}

// Compara dos nombres ignorando mayúsculas/minúsculas, tildes/diacríticos y espacios
// de más, para reconocer al mismo estudiante entre un listado y el siguiente aunque
// venga con pequeñas variaciones de tipeo (ej. "Gómez Ana" vs "Gomez Aná", o un espacio
// doble). Sigue exigiendo que las letras de base coincidan, así que dos nombres
// realmente distintos (ej. hermanos con un legajo familiar compartido) NO se confunden.
function normalizarNombreComparacion(s){
  return (s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').trim().toLowerCase().replace(/\s+/g,' ');
}

// Normaliza el año/sala: busca coincidencia exacta o el mismo número dentro de las
// opciones válidas para ese nivel; si no encuentra nada usa la primera opción del nivel.
function normalizarAnio(txt, nivel){
  const opciones = ANIOS_POR_NIVEL[nivel];
  const t = (txt||'').trim();
  if(!t) return opciones[0];
  const exact = opciones.find(o=> o.toLowerCase()===t.toLowerCase());
  if(exact) return exact;
  if(nivel==='Inicial'){
    // Compatibilidad con la nomenclatura anterior ("Sala de 2", "Sala 3") o con
    // el número de edad solo ("2", "3"): se traduce a la sala nueva equivalente.
    const numI = t.match(/\d+/);
    if(numI){
      const porEdad = Object.entries(SALAS_INICIAL_INFO).find(([,info])=> String(info.edad)===numI[0]);
      if(porEdad) return porEdad[0];
    }
  }
  const num = t.match(/\d+/);
  if(num){
    const n = num[0];
    const porNumero = opciones.find(o=> new RegExp('(^|\\D)'+n+'(\\D|$)').test(o));
    if(porNumero) return porNumero;
  }
  return opciones[0];
}

async function importarCSV(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async (e)=>{
    const texto = e.target.result;
    const delim = detectarDelimitadorCSV(texto);
    const lineas = texto.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    if(!lineas.length){ toast('El archivo está vacío.'); return; }
    let inicio = 0;
    if(/nombre/i.test(lineas[0])) inicio = 1; // saltear encabezado si existe
    let agregados = 0, actualizados = 0, sinCambios = 0;
    for(let i=inicio;i<lineas.length;i++){
      const partes = parseLineaCSV(lineas[i], delim);
      const [nombre, legajo, nivelRaw, anioRaw, division, responsable1, responsable2] = partes;
      if(!nombre || !legajo) continue;
      const nivel = normalizarNivel(nivelRaw);
      const anio = normalizarAnio(anioRaw, nivel);
      const divisionNorm = (division||'').trim();
      // Se identifica la fila con un estudiante ya cargado por LEGAJO + NOMBRE, igual
      // que antes (esto evita que dos hermanos con el mismo "legajo familiar" pero
      // nombres distintos se confundan entre sí), pero ahora el nombre se compara
      // ignorando tildes, mayúsculas y espacios de más -- así una pequeña variación de
      // tipeo entre el listado de este año y el del año que viene (ej. "Gómez Ana" vs
      // "Gomez Aná") sigue reconociendo al mismo estudiante. Si ya existe, en vez de
      // ignorar la fila se actualizan sus datos de curso (nivel, año/sala, división),
      // nombre (con la grafía más reciente) y responsables con lo que diga este CSV.
      // Esto permite dos usos con el mismo mecanismo:
      //  1) Corregir de una sola vez datos mal cargados -- por ejemplo, una sala vieja
      //     que quedó de una restauración de respaldo anterior a la nomenclatura actual
      //     de salas -- simplemente reimportando el listado correcto.
      //  2) Migrar a todos los estudiantes de un año al siguiente (pase de año / cambio
      //     de nivel, ej. de Sala Verde a 1º Primaria, o de 6º Primaria a 1º Secundaria)
      //     reimportando el listado oficial actualizado que entregue el colegio a fin de
      //     año, sin perder nada de lo registrado durante el año (alertas, seguimiento
      //     pedagógico, sociograma, orientación vocacional, etc.), porque en ambos casos
      //     se conserva el mismo id del estudiante y solo se pisan estos campos.
      const existente = AppState.estudiantes.find(a=>a.legajo===legajo && normalizarNombreComparacion(a.nombre)===normalizarNombreComparacion(nombre));
      if(existente){
        if(!existente.familia) existente.familia = {responsable1:'',contacto1:'',responsable2:'',contacto2:'',observaciones:''};
        const nombreNorm = nombre.trim();
        const cambios = existente.nivel!==nivel || existente.anio!==anio || (existente.division||'')!==divisionNorm
          || existente.nombre.trim()!==nombreNorm
          || (responsable1 && existente.familia.responsable1!==responsable1)
          || (responsable2 && existente.familia.responsable2!==responsable2);
        if(cambios){
          existente.nivel = nivel;
          existente.anio = anio;
          existente.division = divisionNorm;
          existente.nombre = nombreNorm;
          if(responsable1) existente.familia.responsable1 = responsable1;
          if(responsable2) existente.familia.responsable2 = responsable2;
          await guardarAlumno(existente);
          actualizados++;
        } else {
          sinCambios++;
        }
        continue;
      }
      const al = estudianteBase(nombre, legajo, nivel, anio, divisionNorm, responsable1||'', responsable2||'');
      AppState.estudiantes.push(al);
      await guardarAlumno(al);
      agregados++;
    }
    renderizarListaAlumnos();
    toast(`Importación completa: ${agregados} estudiante(s) nuevo(s) agregado(s), ${actualizados} actualizado(s) (curso/división corregidos con este listado), ${sinCambios} sin cambios.`);
  };
  reader.readAsText(file);
  evt.target.value = '';
}

// Importa un CSV de 2 columnas (legajo/DNI, número de familia) para vincular hermanos
// que ya están cargados en la plataforma. No crea ni modifica el nivel/curso de nadie:
// solo completa el campo "familiaNumero" de cada estudiante existente cuyo legajo
// coincida, para poder mostrar "Hermanos en el Colegio" en su ficha (Datos y familia).
// Sirve para cruzar un listado de familias del colegio (que suele venir en un archivo
// aparte del listado general de estudiantes) sin tener que cargarlo a mano uno por uno.
async function importarHermanosVinculo(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async (e)=>{
    const texto = e.target.result;
    const delim = detectarDelimitadorCSV(texto);
    const lineas = texto.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    if(!lineas.length){ toast('El archivo está vacío.'); return; }
    let inicio = 0;
    if(/dni|legajo|familia/i.test(lineas[0])) inicio = 1; // saltear encabezado si existe
    let vinculados = 0, sinCambios = 0, sinCoincidencia = 0;
    const noEncontrados = [];
    for(let i=inicio;i<lineas.length;i++){
      const partes = parseLineaCSV(lineas[i], delim);
      const [legajoRaw, familiaRaw] = partes;
      const legajo = (legajoRaw||'').trim();
      const familiaNumero = (familiaRaw||'').trim();
      if(!legajo || !familiaNumero) continue;
      const al = AppState.estudiantes.find(a=>a.legajo===legajo);
      if(!al){ sinCoincidencia++; noEncontrados.push({legajo, familiaNumero}); continue; }
      if(al.familiaNumero === familiaNumero){ sinCambios++; continue; }
      al.familiaNumero = familiaNumero;
      await guardarAlumno(al);
      vinculados++;
    }
    renderizarListaAlumnos();
    if(currentStudentId) renderVistaAlumno();
    toast(`Vínculos de familia: ${vinculados} estudiante(s) vinculado(s)/actualizado(s), ${sinCambios} sin cambios, ${sinCoincidencia} sin coincidencia (legajo no encontrado en la plataforma).`);
    if(noEncontrados.length){
      const modal = document.getElementById('modal-generico');
      modal.querySelector('.modal-content').classList.add('wide');
      modal.querySelector('.modal-content').innerHTML = `
        <h3>Legajos del listado de familias sin coincidencia</h3>
        <p style="color:var(--text-light);font-size:0.85rem;">Estos ${noEncontrados.length} legajo(s)/DNI del archivo que importaste no se encontraron entre los estudiantes ya cargados en la plataforma (puede ser un estudiante que todavía no cargaste, que ya no está activo, o una diferencia de tipeo en el número).</p>
        <div style="max-height:320px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:8px;">
          <table style="width:100%;font-size:0.85rem;"><thead><tr><th style="text-align:left;">Legajo/DNI</th><th style="text-align:left;">Número de familia</th></tr></thead><tbody>
            ${noEncontrados.map(n=>`<tr><td>${escapeHtml(n.legajo)}</td><td>${escapeHtml(n.familiaNumero)}</td></tr>`).join('')}
          </tbody></table>
        </div>
        <div class="modal-actions"><button class="btn btn-primary" onclick="cerrarModal('modal-generico')">Cerrar</button></div>
      `;
      abrirModal('modal-generico');
    }
  };
  reader.readAsText(file);
  evt.target.value = '';
}

/* =========================================================================
   11. SOCIOGRAMA — motor de cálculo (Coie & Dodge, 1983) y UI
   ========================================================================= */

// Devuelve los cursos (nivel+año/sala+división) que tienen al menos un estudiante
// activo cargado, para elegir en Sociograma y Perfil Grupal.
function cursosDisponibles(){
  const mapa = {};
  AppState.estudiantes.filter(a=>a.activo).forEach(al=>{
    const key = cursoKey(al.nivel, al.anio, al.division);
    if(!mapa[key]) mapa[key] = {key, nivel:al.nivel, anio:al.anio, division:al.division, label: cursoLabel(al.nivel, al.anio, al.division)};
  });
  return Object.values(mapa).sort((a,b)=> a.label.localeCompare(b.label));
}

// estudiantesCurso: [{id,...}]; nominaciones: [{estudianteId, positivas:[id], negativas:[id]}]
// Devuelve, por estudiante: LM (elecciones positivas recibidas), LL (negativas recibidas),
// sus z-scores, Preferencia Social (SP=zLM-zLL), Impacto Social (SI=zLM+zLL) y el estatus
// sociométrico según los cortes clásicos de Coie & Dodge (1983).
function calcularSociograma(estudiantesCurso, nominaciones){
  const LM = {}, LL = {};
  estudiantesCurso.forEach(al=>{ LM[al.id]=0; LL[al.id]=0; });
  nominaciones.forEach(nom=>{
    (nom.positivas||[]).forEach(id=>{ if(LM[id]!==undefined) LM[id]++; });
    (nom.negativas||[]).forEach(id=>{ if(LL[id]!==undefined) LL[id]++; });
  });
  const lmArr = estudiantesCurso.map(al=>LM[al.id]);
  const llArr = estudiantesCurso.map(al=>LL[al.id]);
  const mLM = promedio(lmArr), dLM = desvioEstandar(lmArr, mLM) || 1;
  const mLL = promedio(llArr), dLL = desvioEstandar(llArr, mLL) || 1;
  return estudiantesCurso.map(al=>{
    const zLM = (LM[al.id]-mLM)/dLM;
    const zLL = (LL[al.id]-mLL)/dLL;
    const SP = zLM - zLL;
    const SI = zLM + zLL;
    let estatus = 'Promedio';
    if(SP > 1 && zLL < 0) estatus = 'Popular';
    else if(SP < -1 && zLM < 0) estatus = 'Rechazado';
    else if(SI < -1) estatus = 'Aislado';
    else if(SI > 1 && Math.abs(SP) < 1) estatus = 'Controvertido';
    return { estudianteId: al.id, LM: LM[al.id], LL: LL[al.id], zLM: round2(zLM), zLL: round2(zLL), SP: round2(SP), SI: round2(SI), estatus };
  });
}

// Índices grupales de cohesión y disociación (Bronfenbrenner, 1945 / Northway, 1952).
// Cohesión: proporción de todos los pares posibles del curso que son una elección
// positiva recíproca (A eligió a B Y B eligió a A) — mide qué tan "amigado" está
// el grupo entre sí. Disociación: la misma proporción, pero con rechazos
// recíprocos — mide cuánto conflicto mutuo instalado hay en el curso. Ambos se
// expresan como porcentaje del máximo teórico de pares: N·(N−1)/2.
function calcularIndicesGrupales(estudiantesCurso, nominaciones){
  const n = estudiantesCurso.length;
  const totalPares = n > 1 ? (n * (n - 1)) / 2 : 0;
  const posPorId = {}, negPorId = {};
  nominaciones.forEach(nom=>{
    posPorId[nom.estudianteId] = new Set(nom.positivas || []);
    negPorId[nom.estudianteId] = new Set(nom.negativas || []);
  });
  const ids = estudiantesCurso.map(al=>al.id);
  let reciprocasPositivas = 0, reciprocasNegativas = 0;
  for(let i=0; i<ids.length; i++){
    for(let j=i+1; j<ids.length; j++){
      const a = ids[i], b = ids[j];
      if((posPorId[a] && posPorId[a].has(b)) && (posPorId[b] && posPorId[b].has(a))) reciprocasPositivas++;
      if((negPorId[a] && negPorId[a].has(b)) && (negPorId[b] && negPorId[b].has(a))) reciprocasNegativas++;
    }
  }
  return {
    reciprocasPositivas, reciprocasNegativas, totalPares,
    cohesion: totalPares > 0 ? round2(100 * reciprocasPositivas / totalPares) : 0,
    disociacion: totalPares > 0 ? round2(100 * reciprocasNegativas / totalPares) : 0,
  };
}

