async function guardarNominacionesSociograma(){
  const estudiantesCurso = AppState.estudiantes.filter(a=>a.activo && cursoKey(a.nivel,a.anio,a.division)===cursoSeleccionadoSocio);
  const fecha = document.getElementById('socio-fecha').value || new Date().toISOString().slice(0,10);
  const nominaciones = estudiantesCurso.map(al=>{
    const posSel = document.getElementById(`socio-pos-${al.id}`);
    const negSel = document.getElementById(`socio-neg-${al.id}`);
    const positivas = Array.from(posSel.selectedOptions).map(o=>o.value).slice(0,3);
    const negativas = Array.from(negSel.selectedOptions).map(o=>o.value).slice(0,3);
    return {estudianteId: al.id, positivas, negativas};
  });
  const resultado = calcularSociograma(estudiantesCurso, nominaciones);
  const curso = cursosDisponibles().find(c=>c.key===cursoSeleccionadoSocio);
  const socio = {
    id: uid('socio'), fecha, creadoEn: Date.now(), cursoKey: cursoSeleccionadoSocio,
    nivel: curso.nivel, anio: curso.anio, division: curso.division, cursoLabel: curso.label,
    estudiantesSnapshot: estudiantesCurso.map(a=>({id:a.id, nombre:a.nombre})),
    nominaciones, resultado
  };
  AppState.sociogramas.push(socio);
  await guardarSociograma(socio);
  document.getElementById('socio-form-container').innerHTML = '';
  renderPanelSociograma();
  toast('Sociograma calculado y guardado.');
}

