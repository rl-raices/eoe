function renderizarListaAlumnos(){
  const q = document.getElementById('search-input').value.toLowerCase().trim();
  const filtroNivel = document.getElementById('filter-nivel').value;
  const filtroAnio = document.getElementById('filter-anio').value;
  const soloAlertas = document.getElementById('filter-alertas').checked;
  const mostrarEgresados = document.getElementById('filter-egresados').checked;
  const container = document.getElementById('students-container');
  container.innerHTML = '';

  const lista = AppState.estudiantes.filter(al=>{
    if(!mostrarEgresados && !al.activo) return false;
    if(filtroNivel && al.nivel !== filtroNivel) return false;
    if(filtroAnio && al.anio !== filtroAnio) return false;
    if(q && !(al.nombre.toLowerCase().includes(q) || al.legajo.toLowerCase().includes(q))) return false;
    if(soloAlertas && !(al.alertas||[]).some(a=>a.estado==='activa')) return false;
    return true;
  }).sort((a,b)=> a.nombre.localeCompare(b.nombre));

  if(!lista.length){
    container.innerHTML = '<li style="text-align:center;color:#999;font-size:0.85rem;padding:14px 0;">Sin resultados.</li>';
    return;
  }
  lista.forEach(al=>{
    const li = document.createElement('li');
    li.className = 'student-item' + (al.id===currentStudentId ? ' active':'');
    li.onclick = ()=> seleccionarAlumno(al.id);
    const tieneAlerta = (al.alertas||[]).some(a=>a.estado==='activa');
    const avatar = al.fotoBase64
      ? `<img class="avatar" src="${al.fotoBase64}">`
      : `<div class="avatar">${escapeHtml(iniciales(al.nombre))}</div>`;
    li.innerHTML = `
      ${avatar}
      <div style="flex:1;min-width:0;">
        ${!al.activo ? '<span class="st-badge">Egresado</span>' : ''}
        <strong>${escapeHtml(al.nombre)}</strong>
        <small>${escapeHtml(al.nivel)} · ${escapeHtml(al.anio)} ${escapeHtml(al.division||'')} — Legajo #${escapeHtml(al.legajo)}</small>
      </div>
      ${tieneAlerta ? '<span class="alert-dot" title="Tiene alertas activas"></span>' : ''}
    `;
    container.appendChild(li);
  });
}

