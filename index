/* ---------- SUB-TAB: TRAYECTORIA (6 años) ---------- */
function renderVocTrayectoria(al){
  let html = `<div class="header-actions no-print" style="margin-bottom:14px;">
    <button class="btn btn-accent" onclick="abrirModalRegistroVoc('${al.id}')">+ Nuevo registro anual</button>
  </div>`;
  if(!al.trayectoria || !al.trayectoria.length){
    html += '<div class="empty-state">Todavía no hay ciclos lectivos registrados. Usá "+ Nuevo registro anual" para agregar el primero.</div>';
    return html;
  }
  const ordenado = al.trayectoria.slice().sort((a,b)=>a.anioEscolar-b.anioEscolar);
  ordenado.forEach(t=>{
    let pill = '';
    if(t.test && t.test.tipo==='holland') pill = `<span class="riasec-pill">${t.test.holland.codigo}</span>`;
    else if(t.test && t.test.tipo==='sovi') pill = `<span class="sovi-pill">SOVI cargado</span>`;
    else pill = `<span class="sovi-pill" style="background:#f1f1f1;color:#888;border-color:#ddd;">Sin test</span>`;

    html += `
    <div class="year-card">
      <div class="year-card-head" onclick="toggleYearCard('vyc-${t.id}')">
        <div class="left">
          <span class="year-pill">${ordinal(t.anioEscolar)} Año</span>
          <span style="color:var(--text-light);font-size:0.82rem;">Ciclo ${t.cicloLectivo||'—'} · Div. ${escapeHtml(t.division||'—')}</span>
          ${t.orientacionCurricular ? `<span style="font-size:0.78rem;color:var(--text-light);">· ${escapeHtml(t.orientacionCurricular)}</span>` : ''}
          ${pill}
        </div>
        <div class="no-print" style="display:flex;gap:6px;">
          <button class="btn btn-outline btn-sm" onclick="event.stopPropagation();abrirModalRegistroVoc('${al.id}',${t.anioEscolar})">Editar</button>
          <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();eliminarRegistroVoc('${al.id}',${t.anioEscolar})">Eliminar</button>
        </div>
      </div>
      <div class="year-card-body" id="vyc-${t.id}">
        ${t.materiasAfinidad?`<div class="yc-field"><b>Materias de mayor afinidad</b>${escapeHtml(t.materiasAfinidad)}</div>`:''}
        ${t.carrerasInteres?`<div class="yc-field"><b>Carreras / áreas de interés manifestadas</b>${escapeHtml(t.carrerasInteres)}</div>`:''}
        ${t.nivelDefinicion?`<div class="yc-field"><b>Definición vocacional (apreciación del orientador)</b>${escapeHtml(t.nivelDefinicion)}</div>`:''}
        ${renderMiniTestVoc(t.test)}
        ${t.observaciones?`<div class="yc-field"><b>Observaciones de entrevistas / tutoría (confidencial)</b><div class="yc-obs">${escapeHtml(t.observaciones)}</div></div>`:''}
      </div>
    </div>`;
  });
  return html;
}

function toggleYearCard(id){ document.getElementById(id).classList.toggle('open'); }

function renderMiniTestVoc(test){
  if(!test || !test.tipo) return '';
  if(test.tipo==='holland'){
    const h = test.holland;
    let bars = RIASEC_KEYS.map(k=>`
      <div class="bar-row">
        <span>${RIASEC_NOMBRES[k]}</span>
        <div class="bar-track"><div class="bar-fill" style="width:${h[k]}%;background:${RIASEC_COLORES[k]};"></div></div>
        <span class="bar-val">${h[k]}</span>
      </div>`).join('');
    return `<div class="yc-field"><b>Test Holland / RIASEC — Código: ${h.codigo}${h.fuente?(' · Fuente: '+escapeHtml(h.fuente)):''}</b>${bars}
      <div style="margin-top:8px;font-size:0.8rem;">Devolución simplificada — Sociales: <strong>${h.devolucion3Areas.sociales}</strong> · Naturales: <strong>${h.devolucion3Areas.naturales}</strong> · Económicas: <strong>${h.devolucion3Areas.economicas}</strong></div>
    </div>`;
  } else {
    const s = test.sovi;
    let barsInt = Object.keys(SOVI_INTERESES_LABELS).map(k=>`
      <div class="bar-row"><span>${SOVI_INTERESES_LABELS[k]}</span><div class="bar-track"><div class="bar-fill" style="width:${s.intereses[k]||0}%;background:var(--primary);"></div></div><span class="bar-val">${s.intereses[k]||0}</span></div>`).join('');
    let barsHab = Object.keys(SOVI_HABILIDADES_LABELS).map(k=>`
      <div class="bar-row"><span>${SOVI_HABILIDADES_LABELS[k]}</span><div class="bar-track"><div class="bar-fill" style="width:${s.habilidades[k]||0}%;background:var(--accent);"></div></div><span class="bar-val">${s.habilidades[k]||0}</span></div>`).join('');
    return `<div class="yc-field"><b>Test SOVI-3${s.fuente?(' · Fuente: '+escapeHtml(s.fuente)):''}</b>
      <p style="font-size:0.78rem;font-weight:700;margin:8px 0 4px;">Perfil de intereses</p>${barsInt}
      <p style="font-size:0.78rem;font-weight:700;margin:8px 0 4px;">Perfil de habilidades</p>${barsHab}
    </div>`;
  }
}

