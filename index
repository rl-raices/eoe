/* =========================================================================
   9-bis. ORIENTACIÓN VOCACIONAL (solo Secundaria)
   Fusionado desde el Sistema de Seguimiento Vocacional: trayectoria de 6 años con
   test Holland/RIASEC (ciclo básico) o SOVI-3 (ciclo superior), motor de compatibilidad
   con la base de carreras, e informe de síntesis automático.
   ========================================================================= */

function ordinal(n){ return n + 'º'; }

function codigoRiasec(scores){
  return RIASEC_KEYS.slice().sort((a,b)=> (scores[b]||0) - (scores[a]||0)).slice(0,3).join('');
}

function calcularDevolucion3Areas(scores){
  const naturales = Math.round(((scores.I||0) + (scores.R||0)) / 2);
  const sociales  = Math.round(((scores.S||0) + (scores.A||0)) / 2);
  const economicas= Math.round(((scores.E||0) + (scores.C||0)) / 2);
  return {sociales, naturales, economicas};
}

function mapSoviToRiasec(intereses){
  const totales = {R:0,I:0,A:0,S:0,E:0,C:0};
  const pesos = {R:0,I:0,A:0,S:0,E:0,C:0};
  Object.keys(SOVI_A_RIASEC).forEach(escala=>{
    const valor = clamp(intereses[escala]||0, 0, 100);
    const tabla = SOVI_A_RIASEC[escala];
    Object.keys(tabla).forEach(letra=>{
      totales[letra] += valor * tabla[letra];
      pesos[letra] += tabla[letra];
    });
  });
  const resultado = {};
  RIASEC_KEYS.forEach(letra=>{ resultado[letra] = pesos[letra] ? Math.round(totales[letra]/pesos[letra]) : 0; });
  return resultado;
}

// Devuelve {vector:{R,I,A,S,E,C}, origenAnio, origenTipo} usando el registro con test
// más reciente en la trayectoria del alumno, o null si no hay ninguno cargado.
function obtenerVectorRiasecAlumno(alumno){
  const conTest = (alumno.trayectoria||[]).filter(t=>t.test && t.test.tipo).sort((a,b)=>a.anioEscolar-b.anioEscolar);
  if(!conTest.length) return null;
  const ultimo = conTest[conTest.length-1];
  if(ultimo.test.tipo==='holland'){
    const h = ultimo.test.holland;
    return {vector:{R:h.R,I:h.I,A:h.A,S:h.S,E:h.E,C:h.C}, origenAnio: ultimo.anioEscolar, origenTipo:'holland'};
  } else {
    return {vector: mapSoviToRiasec(ultimo.test.sovi.intereses), origenAnio: ultimo.anioEscolar, origenTipo:'sovi'};
  }
}

function similitudCoseno(v1, v2){
  let dot=0, n1=0, n2=0;
  RIASEC_KEYS.forEach(k=>{
    const a=v1[k]||0, b=v2[k]||0;
    dot += a*b; n1 += a*a; n2 += b*b;
  });
  if(n1===0||n2===0) return 0;
  return dot / (Math.sqrt(n1)*Math.sqrt(n2));
}

function matchCarreras(alumno, topN){
  const info = obtenerVectorRiasecAlumno(alumno);
  if(!info) return {origen:null, resultados:[]};
  const resultados = AppState.carreras.map(car=>{
    const sim = similitudCoseno(info.vector, car.riasec);
    return {carrera:car, porcentaje: Math.round(sim*100)};
  }).sort((a,b)=>b.porcentaje - a.porcentaje);
  return {origen: info, resultados: topN ? resultados.slice(0,topN) : resultados};
}

function primerNombre(nombreCompleto){
  const partes = nombreCompleto.split(',');
  if(partes.length>1) return partes[1].trim().split(' ')[0];
  return nombreCompleto.split(' ')[0];
}

function generarInformeSintesis(alumno){
  const conTest = (alumno.trayectoria||[]).filter(t=>t.test && t.test.tipo).sort((a,b)=>a.anioEscolar-b.anioEscolar);
  if(!conTest.length){
    return '<p>Todavía no hay registros con test vocacional cargado para este estudiante. Cargá al menos un ciclo lectivo con el test de Holland/RIASEC o SOVI-3 en la pestaña "Cargar registro anual" para generar la síntesis.</p>';
  }
  const nombre = primerNombre(alumno.nombre);

  const letraFrecuencia = {R:0,I:0,A:0,S:0,E:0,C:0};
  conTest.forEach(t=>{
    let vec;
    if(t.test.tipo==='holland') vec = {R:t.test.holland.R,I:t.test.holland.I,A:t.test.holland.A,S:t.test.holland.S,E:t.test.holland.E,C:t.test.holland.C};
    else vec = mapSoviToRiasec(t.test.sovi.intereses);
    const top2 = RIASEC_KEYS.slice().sort((a,b)=>vec[b]-vec[a]).slice(0,2);
    top2.forEach(l=> letraFrecuencia[l]++);
  });
  const letrasOrdenadas = RIASEC_KEYS.slice().sort((a,b)=>letraFrecuencia[b]-letraFrecuencia[a]);
  const letraTop1 = letrasOrdenadas[0], letraTop2 = letrasOrdenadas[1];

  const primero = conTest[0], ultimo = conTest[conTest.length-1];
  const vecPrimero = primero.test.tipo==='holland' ? {R:primero.test.holland.R,I:primero.test.holland.I,A:primero.test.holland.A,S:primero.test.holland.S,E:primero.test.holland.E,C:primero.test.holland.C} : mapSoviToRiasec(primero.test.sovi.intereses);
  const vecUltimo = ultimo.test.tipo==='holland' ? {R:ultimo.test.holland.R,I:ultimo.test.holland.I,A:ultimo.test.holland.A,S:ultimo.test.holland.S,E:ultimo.test.holland.E,C:ultimo.test.holland.C} : mapSoviToRiasec(ultimo.test.sovi.intereses);
  const topPrimero = RIASEC_KEYS.slice().sort((a,b)=>vecPrimero[b]-vecPrimero[a])[0];
  const topUltimo = RIASEC_KEYS.slice().sort((a,b)=>vecUltimo[b]-vecUltimo[a])[0];
  const estable = topPrimero === topUltimo;

  const materias = [...new Set(alumno.trayectoria.map(t=>t.materiasAfinidad).filter(Boolean))];
  const carrerasManifestadas = [...new Set(alumno.trayectoria.map(t=>t.carrerasInteres).filter(Boolean))];

  const match = matchCarreras(alumno, 3);
  const matchTexto = match.resultados.length
    ? match.resultados.map(m=>`<strong>${escapeHtml(m.carrera.nombre)}</strong> (${m.porcentaje}% de afinidad)`).join(', ')
    : '';

  const conDefinicion = alumno.trayectoria.filter(t=>t.nivelDefinicion).sort((a,b)=>a.anioEscolar-b.anioEscolar);
  let definicionTexto = '';
  if(conDefinicion.length){
    const def0 = conDefinicion[0], defN = conDefinicion[conDefinicion.length-1];
    if(conDefinicion.length>1 && def0.nivelDefinicion !== defN.nivelDefinicion){
      definicionTexto = `Respecto a la definición de su proyecto vocacional, pasó de "${def0.nivelDefinicion}" en ${ordinal(def0.anioEscolar)} año a "${defN.nivelDefinicion}" en ${ordinal(defN.anioEscolar)} año.`;
    } else {
      definicionTexto = `Al momento de su último registro, el nivel de definición vocacional apreciado por el equipo de orientación es "${defN.nivelDefinicion}".`;
    }
  }

  let html = `<p>A lo largo de ${conTest.length} ciclo${conTest.length>1?'s':''} lectivo${conTest.length>1?'s':''} con evaluación vocacional registrada (entre ${ordinal(conTest[0].anioEscolar)} y ${ordinal(conTest[conTest.length-1].anioEscolar)} año), <strong>${escapeHtml(nombre)}</strong> muestra mayor afinidad hacia las áreas <strong>${RIASEC_NOMBRES[letraTop1]}</strong>${letraTop2?` y <strong>${RIASEC_NOMBRES[letraTop2]}</strong>`:''}, tendencia que se mantuvo ${estable?'relativamente estable':'con variaciones'} a lo largo de su trayectoria escolar.</p>`;

  if(materias.length){
    html += `<p>Las materias de mayor afinidad o rendimiento percibido a lo largo de los años fueron: ${escapeHtml(materias.join(' · '))}.</p>`;
  }
  if(carrerasManifestadas.length){
    html += `<p>Las carreras o áreas de interés que manifestó en distintos momentos incluyen: ${escapeHtml(carrerasManifestadas.join(' · '))}.</p>`;
  }
  if(matchTexto){
    html += `<p>Según el motor de compatibilidad (comparando su perfil vocacional más reciente, del ${ordinal(match.origen.origenAnio)} año, contra la base de carreras), las opciones con mayor afinidad son: ${matchTexto}.</p>`;
  }
  if(definicionTexto){
    html += `<p>${definicionTexto}</p>`;
  }
  html += `<p style="font-size:0.78rem;color:var(--text-light);border-top:1px dashed var(--ok-border);padding-top:8px;margin-top:12px;">Esta síntesis fue generada automáticamente por reglas internas del sistema a partir de los datos cargados, no por una inteligencia artificial externa. Es un insumo para la devolución del equipo de orientación, no un diagnóstico ni una indicación de qué carrera debe seguir el estudiante.</p>`;

  return html;
}

