// v2: agrega el object store 'carreras' (Base de Carreras, fusión con Orientación
// Vocacional). Subir la versión es necesario para que el navegador dispare
// onupgradeneeded y cree el store nuevo en cualquier base ya existente en esa
// computadora (por ejemplo, si ya se había abierto antes el sistema socioemocional
// solo, sin la Base de Carreras) — si se dejaba en 1, esas instalaciones se quedaban
// sin el store nuevo y la Base de Carreras aparecía vacía.
const DB_VERSION = 2; // ya no se usa para IndexedDB, se deja solo de referencia histórica.

/* -------------------------------------------------------------------------
   Persistencia sobre Firestore (reemplaza IndexedDB).
   Se mantienen exactamente los mismos nombres y firmas de función
   (dbGetAll, dbGet, dbPut, dbDelete) para que el resto del sistema —
   guardarAlumno, guardarSociograma, guardarConfig, etc.— no necesite
   ningún otro cambio.
   'store' es el nombre de la colección en Firestore ('meta', 'estudiantes',
   'sociogramas', 'climaEncuestas', 'carreras'). El id del documento en
   Firestore es 'obj.key' para la colección 'meta' y 'obj.id' para el resto,
   igual que el keyPath que usaba IndexedDB.
   ------------------------------------------------------------------------- */

async function dbGetAll(store){
  const snap = await firestoreDb.collection(store).get();
  return snap.docs.map(d => d.data());
}
async function dbGet(store, key){
  const doc = await firestoreDb.collection(store).doc(String(key)).get();
  return doc.exists ? doc.data() : undefined;
}
async function dbPut(store, obj){
  const docId = String(obj.key !== undefined ? obj.key : obj.id);
  await firestoreDb.collection(store).doc(docId).set(obj);
  programarRespaldoAutomatico();
  return docId;
}
async function dbDelete(store, key){
  await firestoreDb.collection(store).doc(String(key)).delete();
  programarRespaldoAutomatico();
}

/* =========================================================================
   3-bis. RESPALDO AUTOMÁTICO A LA CARPETA DE DESCARGAS
   -------------------------------------------------------------------------
   IndexedDB (de arriba) guarda los datos DENTRO del navegador, en esta
   computadora. Es normal y anda bien, pero depende de que el navegador no
   borre esa base por su cuenta (algo puede pasar por configuración de
   "borrar datos de sitios al cerrar", perfil de Invitado/incógnito,
   extensiones "limpiadoras", antivirus con limpieza automática, etc.).
   Como red de seguridad adicional, si se activa "Respaldo automático" en
   Configuración, cada vez que se guarda o borra algo en la base (o sea,
   cada vez que se llama a dbPut/dbDelete de arriba) se programa -- con
   unos segundos de espera para agrupar cambios seguidos -- la descarga
   automática de un archivo .json con el estado completo a la carpeta de
   Descargas del navegador, igual que "Exportar respaldo" pero sin tener
   que apretar el botón. Importante: esto NO reemplaza guardar copias
   fuera de esta computadora (pendrive, Drive institucional, etc.): si esta
   computadora se pierde, se rompe o se borra la carpeta de Descargas, estos
   archivos se pierden con ella.
   ========================================================================= */

let _autoBackupTimer = null;
let _ejecutandoRespaldoAuto = false;
let ultimoRespaldoAutoEnEstaSesion = null; // solo informativo en pantalla; no se persiste

function programarRespaldoAutomatico(){
  if(_ejecutandoRespaldoAuto) return; // evita que el propio respaldo se dispare a sí mismo en cadena
  if(!AppState || !AppState.config || !AppState.config.autoRespaldoActivo) return;
  if(_autoBackupTimer) clearTimeout(_autoBackupTimer);
  // Espera 8 segundos sin más cambios antes de descargar, para no generar un
  // archivo distinto por cada campo que se guarda en una carga con varios pasos.
  _autoBackupTimer = setTimeout(()=>{ _autoBackupTimer = null; ejecutarRespaldoAutomatico(); }, 8000);
}

function ejecutarRespaldoAutomatico(){
  try{
    _ejecutandoRespaldoAuto = true;
    const data = JSON.stringify(AppState, null, 2);
    const blob = new Blob([data], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const ahora = new Date();
    const fecha = ahora.toISOString().slice(0,10);
    const hora = ahora.toTimeString().slice(0,8).replace(/:/g,'-');
    const nivelSlug = AppState.config.nivelComputadora ? '_' + AppState.config.nivelComputadora.toLowerCase() : '';
    a.href = url;
    a.download = `respaldo_auto_seguimiento_socioemocional${nivelSlug}_${fecha}_${hora}.json`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
    ultimoRespaldoAutoEnEstaSesion = ahora;
    const info = document.getElementById('info-respaldo-auto');
    if(info) info.textContent = `Último respaldo automático en esta sesión: ${ahora.toLocaleString('es-AR')}.`;
  } finally {
    _ejecutandoRespaldoAuto = false;
  }
}

async function alternarRespaldoAutomatico(){
  AppState.config.autoRespaldoActivo = !AppState.config.autoRespaldoActivo;
  await guardarConfig();
  toast(AppState.config.autoRespaldoActivo ? 'Respaldo automático activado: se va a descargar solo a Descargas después de cada cambio.' : 'Respaldo automático desactivado.');
  renderPanelConfig();
}
async function dbClear(store){
  const snap = await firestoreDb.collection(store).get();
  // Firestore permite hasta 500 operaciones por lote (batch).
  const docs = snap.docs;
  for(let i=0; i<docs.length; i+=450){
    const batch = firestoreDb.batch();
    docs.slice(i, i+450).forEach(d => batch.delete(d.ref));
    await batch.commit();
  }
}

