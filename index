function initLogin(){
  document.getElementById('dominio-permitido-txt').textContent = ALLOWED_DOMAIN;
  const err = document.getElementById('login-error');
  auth.onAuthStateChanged(async (user)=>{
    if(user && user.email && user.email.toLowerCase().endsWith('@' + ALLOWED_DOMAIN.toLowerCase())){
      err.textContent = '';
      await cargarEstadoCompleto();
      await entrarAlApp();
    } else if(user){
      // Logueado con Google pero con una cuenta fuera del dominio institucional.
      err.textContent = 'Esta cuenta de Google no pertenece al colegio (@' + ALLOWED_DOMAIN + '). Cerrá sesión e ingresá con tu cuenta institucional.';
      await auth.signOut();
    }
  });
}

async function iniciarSesionGoogle(){
  const err = document.getElementById('login-error');
  err.textContent = '';
  const provider = new firebase.auth.GoogleAuthProvider();
  provider.setCustomParameters({ hd: ALLOWED_DOMAIN }); // sugiere el dominio institucional en el selector de cuentas
  try{
    await auth.signInWithPopup(provider);
    // El resto lo maneja onAuthStateChanged, arriba.
  } catch(e){
    err.textContent = 'No se pudo iniciar sesión: ' + (e && e.message ? e.message : e);
  }
}

