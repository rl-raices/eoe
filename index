// Exporta la base de carreras actual a un archivo CSV (nombre;instituciones;R;I;A;S;E;C)
// para que se pueda guardar en la computadora y editar con Excel u otra planilla, en vez
// de tener que editar carrera por carrera en esta pantalla. Usa ";" como separador (en vez
// de ",") porque el nombre de las instituciones normalmente ya contiene comas (ej. "UNLP,
// UBA, UTN"), y agrega una marca UTF-8 (BOM) al inicio para que Excel abra bien los acentos.
function exportarCarrerasCSV(){
  const header = 'nombre;instituciones;R;I;A;S;E;C';
  const filas = AppState.carreras.map(c=>{
    const nombre = (c.nombre||'').replace(/;/g,',');
    const instituciones = (c.instituciones||[]).join(', ').replace(/;/g,',');
    const valores = RIASEC_KEYS.map(k=>c.riasec[k]).join(';');
    return `${nombre};${instituciones};${valores}`;
  });
  const csv = [header, ...filas].join('\r\n');
  const blob = new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const fecha = new Date().toISOString().slice(0,10);
  a.href = url;
  a.download = `base_de_carreras_${fecha}.csv`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
  toast('Base de carreras exportada. Guardala en tu computadora para editarla y volver a importarla cuando quieras.');
}

// Importa un CSV de carreras (mismo formato que exporta exportarCarrerasCSV: nombre,
// instituciones, y los 6 valores RIASEC en el orden R,I,A,S,E,C). Identifica cada fila por
// el NOMBRE de la carrera (ignorando tildes/mayúsculas/espacios de más, igual que al
// identificar estudiantes): si ya existe una carrera con ese nombre, actualiza sus
// instituciones y su perfil RIASEC; si no existe, la agrega como carrera nueva. Ninguna
// carrera existente se elimina por no figurar en el archivo importado (para eso está
// "Restaurar lista original" o borrarla a mano).
async function importarCarrerasCSV(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async (e)=>{
    const texto = e.target.result;
    const delim = detectarDelimitadorCSV(texto);
    const lineas = texto.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    if(!lineas.length){ toast('El archivo está vacío.'); return; }
    let inicio = 0;
    if(/nombre/i.test(lineas[0])) inicio = 1; // saltear encabezado si existe
    let agregadas = 0, actualizadas = 0, sinCambios = 0, invalidas = 0;
    for(let i=inicio;i<lineas.length;i++){
      const partes = parseLineaCSV(lineas[i], delim);
      const [nombre, institucionesRaw, rRaw, iRaw, aRaw, sRaw, eRaw, cRaw] = partes;
      if(!nombre) continue;
      const valoresRaw = [rRaw, iRaw, aRaw, sRaw, eRaw, cRaw];
      if(valoresRaw.some(v=>v===undefined || v==='' || isNaN(Number(v)))){ invalidas++; continue; }
      const instituciones = (institucionesRaw||'').split(',').map(s=>s.trim()).filter(Boolean);
      const riasec = {};
      RIASEC_KEYS.forEach((k,idx)=>{ riasec[k] = clamp(valoresRaw[idx], 0, 100); });
      const existente = AppState.carreras.find(c=>normalizarClaveEstudiante(c.nombre)===normalizarClaveEstudiante(nombre));
      if(existente){
        const cambios = JSON.stringify(existente.instituciones||[])!==JSON.stringify(instituciones)
          || RIASEC_KEYS.some(k=>Number(existente.riasec[k])!==Number(riasec[k]));
        if(cambios){
          existente.instituciones = instituciones;
          existente.riasec = riasec;
          await guardarCarreraDB(existente);
          actualizadas++;
        } else {
          sinCambios++;
        }
        continue;
      }
      const car = {id:uid('car'), nombre:nombre.trim(), instituciones, riasec};
      AppState.carreras.push(car);
      await guardarCarreraDB(car);
      agregadas++;
    }
    renderPanelCarreras();
    toast(`Base de carreras: ${agregadas} nueva(s), ${actualizadas} actualizada(s), ${sinCambios} sin cambios${invalidas?`, ${invalidas} fila(s) con error (RIASEC incompleto o no numérico)`:''}.`);
  };
  reader.readAsText(file);
  evt.target.value = '';
}

