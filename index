async function guardarClaveMaestra(){
  const err = document.getElementById('cfg-clavemaestra-error');
  const tieneClave = !!AppState.config.claveMaestraHash;
  if(tieneClave){
    const actual = document.getElementById('cfg-clavemaestra-actual').value;
    if(simpleHash(actual) !== AppState.config.claveMaestraHash){ err.textContent = 'La contraseña maestra actual no es correcta.'; return; }
  }
  const n1 = document.getElementById('cfg-clavemaestra-nueva').value;
  const n2 = document.getElementById('cfg-clavemaestra-nueva2').value;
  if(n1.length < 6){ err.textContent = 'La contraseña maestra debe tener al menos 6 caracteres.'; return; }
  if(n1 !== n2){ err.textContent = 'Las contraseñas maestras no coinciden.'; return; }
  AppState.config.claveMaestraHash = simpleHash(n1);
  await guardarConfig();
  toast('Contraseña maestra guardada.');
  renderPanelConfig();
}
