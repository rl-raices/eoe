function renderSelectorVocacional(){
  // El año de Secundaria se guarda como texto ("1º".."6º", ver ANIOS_POR_NIVEL),
  // no como número — por eso ordenamos y agrupamos extrayendo el número con
  // parseInt en vez de restar los valores directamente.
  const anioNum = a => parseInt(a.anio, 10) || 0;
  const secundarios = AppState.estudiantes.filter(a=>a.activo && a.nivel==='Secundaria').sort((a,b)=> (anioNum(a)-anioNum(b)) || a.nombre.localeCompare(b.nombre));
  if(!secundarios.length) return '<div class="empty-state">Todavía no hay estudiantes activos de Secundaria cargados.</div>';
  const porAnio = {};
  secundarios.forEach(a=>{ (porAnio[a.anio] = porAnio[a.anio] || []).push(a); });
  let html = '<p style="color:var(--text-light);font-size:0.85rem;margin-bottom:14px;">Elegí un estudiante de Secundaria para ver su trayectoria de Orientación Vocacional.</p>';
  Object.keys(porAnio).sort((a,b)=> (parseInt(a,10)||0)-(parseInt(b,10)||0)).forEach(anio=>{
    html += `<h4 style="margin:14px 0 8px;">${escapeHtml(anio)} Año</h4><ul class="student-list">`;
    porAnio[anio].forEach(a=>{
      html += `<li class="student-item" onclick="abrirVocacionalAlumno('${a.id}')"><span><strong>${escapeHtml(a.nombre)}</strong></span><small>Div. ${escapeHtml(a.division||'—')}</small></li>`;
    });
    html += '</ul>';
  });
  return html;
}

