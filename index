async function crearAlumno(){
  const nombre = document.getElementById('new-nombre').value.trim();
  const legajo = document.getElementById('new-legajo').value.trim();
  const nivel = document.getElementById('new-nivel').value;
  const anio = document.getElementById('new-anio').value;
  const division = document.getElementById('new-division').value.trim();
  const responsable1 = document.getElementById('new-responsable1').value.trim();
  const responsable2 = document.getElementById('new-responsable2').value.trim();
  if(!nombre || !legajo){ toast('Completá nombre y legajo.'); return; }
  // Igual que en el sistema vocacional: solo bloqueamos si legajo Y nombre coinciden
  // exactamente (mismo estudiante cargado dos veces). El mismo legajo con nombres
  // distintos se permite (hermanos con legajo familiar compartido).
  if(AppState.estudiantes.some(a=>a.legajo===legajo && a.nombre.trim().toLowerCase()===nombre.toLowerCase())){
    toast('Ya existe un estudiante con ese nombre y legajo.'); return;
  }
  const al = estudianteBase(nombre, legajo, nivel, anio, division, responsable1, responsable2);
  AppState.estudiantes.push(al);
  await guardarAlumno(al);
  cerrarModal('modal-nuevo-alumno');
  renderizarListaAlumnos();
  toast('Estudiante registrado.');
  seleccionarAlumno(al.id);
}

