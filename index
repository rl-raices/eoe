function subirSociogramaExterno(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const etiqueta = document.getElementById('socioext-etiqueta').value.trim();
  const fecha = document.getElementById('socioext-fecha').value || new Date().toISOString().slice(0,10);
  const reader = new FileReader();
  reader.onload = async (e)=>{
    const registro = {
      id: uid('socioext'), esExterno: true, fecha, creadoEn: Date.now(), etiqueta,
      archivoNombre: file.name, archivoTipo: file.type, archivoBase64: e.target.result
    };
    AppState.sociogramas.push(registro);
    await guardarSociograma(registro);
    evt.target.value = '';
    renderPanelSociograma();
    toast('Archivo adjuntado.');
  };
  reader.readAsDataURL(file);
}

function verSociogramaExterno(id){
