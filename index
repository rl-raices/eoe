    wrapH.innerHTML = '';
    const s = (existente && existente.test && existente.test.tipo==='sovi') ? existente.test.sovi : null;
    wrapS.innerHTML = `
      <fieldset>
        <legend>Test vocacional — SOVI-3 (Ciclo Superior)
          <span class="legend-sub">Cargá los percentiles del informe SOVI-3 (Fogliatto y Pérez, Ed. Paidós) u otro instrumento equivalente que use tu colegio.</span>
        </legend>
        <div class="form-group">
          <label>Fuente / instrumento utilizado</label>
          <input type="text" id="s-fuente" placeholder="Ej: SOVI-3 (Fogliatto y Pérez)" value="${s?escapeHtml(s.fuente):'SOVI-3 (Fogliatto y Pérez)'}">
        </div>
        <p style="font-weight:700;font-size:0.85rem;margin-bottom:6px;">Perfil de intereses (percentil 0-100)</p>
        <div class="num-grid">
          ${Object.keys(SOVI_INTERESES_LABELS).map(k=>`
            <div class="num-field"><label>${SOVI_INTERESES_LABELS[k]}</label>
            <input type="number" min="0" max="100" id="s-int-${k}" value="${s?s.intereses[k]:''}"></div>`).join('')}
        </div>
        <p style="font-weight:700;font-size:0.85rem;margin:14px 0 6px;">Perfil de habilidades (percentil 0-100)</p>
        <div class="num-grid">
          ${Object.keys(SOVI_HABILIDADES_LABELS).map(k=>`
            <div class="num-field"><label>${SOVI_HABILIDADES_LABELS[k]}</label>
