function nivelBienestar(promedioGeneral){
  if(promedioGeneral >= 4) return 'Alto';
  if(promedioGeneral >= 3) return 'Medio';
  return 'Bajo';
}
function colorPorValor(v){
  if(v>=4) return '#38A935';
  if(v>=3) return '#b8720b';
  return '#c0392b';
}

let vistaClima = 'curso'; // 'curso' | 'mapa'

