   Dirección): al no haber login ni pantalla separada para la Dirección en esta
   arquitectura local, se resuelve como una única vista que el EOE puede
   consultar para orientarse, e imprimir como informe agregado (sin datos
   individuales identificables) cada vez que la Dirección lo solicita.
   ========================================================================= */

function statCard(value, label, destacado){
  return `
    <div class="stat-card" style="${destacado ? 'border-color:var(--danger);' : ''}">
      <div class="stat-value" style="${destacado ? 'color:var(--danger);' : ''}">${value}</div>
      <div class="stat-label">${escapeHtml(label)}</div>
    </div>
  `;
}

// filtroNivel: 'Todos' | 'Inicial' | 'Primaria' | 'Secundaria' | null (equivale a 'Todos').
// El desglose por nivel del encabezado (porNivelTotal) siempre se calcula sobre TODOS los
// estudiantes activos, sin importar el filtro: representa la trayectoria institucional
// completa. El resto de las estadísticas (porNivel, alertas, sociograma, clima, vocacional)
// respeta el filtro, para que cada equipo de nivel vea el detalle de su propio nivel.
function calcularEstadisticasInstitucionales(filtroNivel){
  const todosActivos = AppState.estudiantes.filter(a=>a.activo);
  const porNivelTotal = {Inicial:0, Primaria:0, Secundaria:0};
  todosActivos.forEach(a=>{ if(porNivelTotal[a.nivel]!==undefined) porNivelTotal[a.nivel]++; });

  const activos = (filtroNivel && filtroNivel!=='Todos') ? todosActivos.filter(a=>a.nivel===filtroNivel) : todosActivos;
  const porNivel = {Inicial:0, Primaria:0, Secundaria:0};
  activos.forEach(a=>{ if(porNivel[a.nivel]!==undefined) porNivel[a.nivel]++; });

  let alertasActivasTotal = 0;
  const porGravedad = {baja:0, media:0, alta:0};
  const porTipo = {};
  activos.forEach(a=>{
    (a.alertas||[]).forEach(al=>{
      if(al.estado==='activa'){
        alertasActivasTotal++;
        if(porGravedad[al.gravedad]!==undefined) porGravedad[al.gravedad]++;
        porTipo[al.tipo] = (porTipo[al.tipo]||0) + 1;
      }
    });
  });

  const cursos = cursosDisponibles().filter(c => !filtroNivel || filtroNivel==='Todos' || c.nivel===filtroNivel);
  let tomasSocioCount = 0;
  const cohesiones = [], disociaciones = [];
  cursos.forEach(c=>{
    const historicos = AppState.sociogramas.filter(s=>s.cursoKey===c.key && !s.esExterno);
    tomasSocioCount += historicos.length;
    const ultima = historicos.slice().sort((a,b)=>(new Date(b.fecha)-new Date(a.fecha))||((b.creadoEn||0)-(a.creadoEn||0)))[0];
    if(ultima){
      const ind = calcularIndicesGrupales(ultima.estudiantesSnapshot, ultima.nominaciones);
      cohesiones.push(ind.cohesion);
      disociaciones.push(ind.disociacion);
    }
  });

  const climaDist = {Alto:0, Medio:0, Bajo:0};
  let cursosConClima = 0;
  cursos.forEach(c=>{
    const ultima = ultimaClimaDeCurso(c.key);
    if(ultima && ultima.nivelGeneral){ climaDist[ultima.nivelGeneral]++; cursosConClima++; }
  });

  const secundaria = activos.filter(a=>a.nivel==='Secundaria');
  const conRegistroVoc = secundaria.filter(a=>(a.trayectoria||[]).length>0).length;

  return {
    porNivelTotal,
    totalActivos: activos.length, porNivel,
    alertasActivasTotal, porGravedad, porTipo,
    tomasSocioCount, cursosConSociograma: cohesiones.length,
    cohesionProm: cohesiones.length ? round2(promedio(cohesiones)) : null,
    disociacionProm: disociaciones.length ? round2(promedio(disociaciones)) : null,
    cursosConClima, totalCursos: cursos.length, climaDist,
    secundariaTotal: secundaria.length, conRegistroVoc,
  };
}

