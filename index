function uid(prefix){ return (prefix||'id') + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,8); }

function simpleHash(str){
  str = String(str)+'::sel-rg-salt';
  let hash = 5381;
  for (let i=0;i<str.length;i++){
    hash = ((hash << 5) + hash) + str.charCodeAt(i);
    hash = hash & 0xffffffff;
  }
  return (hash >>> 0).toString(36);
}

function escapeHtml(str){
  if(str===undefined||str===null) return '';
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function clamp(n, min, max){ n = Number(n); if(isNaN(n)) return min; return Math.max(min, Math.min(max, n)); }
function round2(n){ return Math.round(n*100)/100; }
function promedio(arr){ if(!arr.length) return 0; return arr.reduce((a,b)=>a+b,0)/arr.length; }
function desvioEstandar(arr, media){
  if(arr.length<2) return 0;
  const m = media!==undefined?media:promedio(arr);
  const variancia = arr.reduce((s,v)=>s+Math.pow(v-m,2),0)/arr.length;
  return Math.sqrt(variancia);
}
function iniciales(nombre){
  return nombre.split(/[\s,]+/).filter(Boolean).slice(0,2).map(p=>p[0]).join('').toUpperCase();
}

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=> t.classList.remove('show'), 2600);
}

