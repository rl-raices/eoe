// Mapa vincular simple: nodos distribuidos en círculo, con líneas que representan
// las elecciones positivas (verde) y negativas (rojo punteado) entre estudiantes.
function dibujarMapaVincular(socio){
  const nodos = socio.estudiantesSnapshot;
  const n = nodos.length;
  const size = Math.max(420, Math.min(720, 120 + n*26));
  const cx = size/2, cy = size/2, r = size/2 - 60;
  const pos = {};
  nodos.forEach((al,i)=>{
    const ang = (2*Math.PI*i/n) - Math.PI/2;
    pos[al.id] = { x: cx + r*Math.cos(ang), y: cy + r*Math.sin(ang) };
  });
  const estatusPorId = {};
  socio.resultado.forEach(r=> estatusPorId[r.estudianteId]=r.estatus);
  const colorEstatus = {Popular:'#38A935', Rechazado:'#c0392b', Aislado:'#999999', Controvertido:'#b8720b', Promedio:'#2A327B'};

  let lineas = '';
  socio.nominaciones.forEach(nom=>{
    const from = pos[nom.estudianteId];
    if(!from) return;
    (nom.positivas||[]).forEach(id=>{
      const to = pos[id]; if(!to) return;
      lineas += `<line x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" stroke="#38A935" stroke-width="1.4" opacity="0.55"/>`;
    });
    (nom.negativas||[]).forEach(id=>{
      const to = pos[id]; if(!to) return;
      lineas += `<line x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" stroke="#c0392b" stroke-width="1.2" stroke-dasharray="5,4" opacity="0.5"/>`;
    });
  });

  let puntos = '';
  nodos.forEach(al=>{
    const p = pos[al.id];
    const est = estatusPorId[al.id] || 'Promedio';
    const color = colorEstatus[est] || '#2A327B';
    puntos += `
      <circle cx="${p.x}" cy="${p.y}" r="17" fill="#fff" stroke="${color}" stroke-width="3.5"><title>${escapeHtml(al.nombre)} — ${est}</title></circle>
      <text x="${p.x}" y="${p.y+4}" text-anchor="middle" font-size="10" font-weight="800" fill="${color}" style="pointer-events:none;">${escapeHtml(iniciales(al.nombre))}</text>
    `;
  });

  return `<svg viewBox="0 0 ${size} ${size}" width="100%" style="max-width:${size}px;display:block;margin:0 auto;">${lineas}${puntos}</svg>`;
}

// Mapa vincular por afinidad: en vez de posiciones fijas en círculo, corre una
// simulación de Fruchterman & Reingold (1991) — cada par de estudiantes se
// repele, y cada elección positiva actúa como un resorte que atrae — así los
// subgrupos con elecciones mutuas quedan agrupados espacialmente y los
// aislados quedan naturalmente alejados de todos. Los pares con rechazo mutuo
// reciben además un extra de repulsión, para separarlos visualmente.
function dibujarMapaPorFuerzas(socio){
  const nodos = socio.estudiantesSnapshot;
  const n = nodos.length;
  if(n === 0) return '<p class="empty-state">Sin datos.</p>';
  const size = Math.max(420, Math.min(720, 120 + n*26));
  const idx = {};
  nodos.forEach((al,i)=> idx[al.id] = i);

  // Pares (i<j) con elección positiva → fuerza de atracción; con rechazo mutuo → repulsión extra
  const posPares = new Set(), negPares = new Set();
  socio.nominaciones.forEach(nom=>{
    const i = idx[nom.estudianteId];
    if(i === undefined) return;
    (nom.positivas||[]).forEach(id=>{ const j = idx[id]; if(j===undefined) return; posPares.add(i<j?`${i}-${j}`:`${j}-${i}`); });
    (nom.negativas||[]).forEach(id=>{ const j = idx[id]; if(j===undefined) return; negPares.add(i<j?`${i}-${j}`:`${j}-${i}`); });
  });

  // Posición inicial en círculo (punto de partida estable para que la simulación converja)
  const cx = size/2, cy = size/2, r0 = size/2 - 60;
  let pos = nodos.map((al,i)=>{
    const ang = (2*Math.PI*i/n) - Math.PI/2;
    return { x: cx + r0*Math.cos(ang), y: cy + r0*Math.sin(ang) };
  });

  const area = size*size;
  const k = Math.sqrt(area / Math.max(n,1));
  let temp = size/10;
  const ITERACIONES = 300;
  for(let iter=0; iter<ITERACIONES; iter++){
    const disp = nodos.map(()=>({x:0,y:0}));
    // Repulsión entre todos los pares
    for(let i=0;i<n;i++){
      for(let j=i+1;j<n;j++){
        let dx = pos[i].x - pos[j].x, dy = pos[i].y - pos[j].y;
        let dist = Math.sqrt(dx*dx+dy*dy) || 0.01;
        let fr = (k*k)/dist;
        if(negPares.has(`${i}-${j}`)) fr *= 1.8;
        const fx = (dx/dist)*fr, fy = (dy/dist)*fr;
        disp[i].x += fx; disp[i].y += fy;
        disp[j].x -= fx; disp[j].y -= fy;
      }
    }
    // Atracción tipo resorte entre pares con elección positiva
    posPares.forEach(key=>{
      const [i,j] = key.split('-').map(Number);
      let dx = pos[i].x - pos[j].x, dy = pos[i].y - pos[j].y;
      let dist = Math.sqrt(dx*dx+dy*dy) || 0.01;
      const fa = (dist*dist)/k;
      const fx = (dx/dist)*fa, fy = (dy/dist)*fa;
      disp[i].x -= fx; disp[i].y -= fy;
      disp[j].x += fx; disp[j].y += fy;
    });
    // Aplicar desplazamiento, acotado por la "temperatura" (enfriamiento progresivo)
    for(let i=0;i<n;i++){
      let dx = disp[i].x, dy = disp[i].y;
      let dist = Math.sqrt(dx*dx+dy*dy) || 0.01;
      pos[i].x += (dx/dist) * Math.min(dist, temp);
      pos[i].y += (dy/dist) * Math.min(dist, temp);
      pos[i].x = Math.min(size-30, Math.max(30, pos[i].x));
      pos[i].y = Math.min(size-30, Math.max(30, pos[i].y));
    }
    temp *= 0.97;
  }

  const posPorId = {};
  nodos.forEach((al,i)=> posPorId[al.id] = pos[i]);
  const estatusPorId = {};
  socio.resultado.forEach(r=> estatusPorId[r.estudianteId]=r.estatus);
  const colorEstatus = {Popular:'#38A935', Rechazado:'#c0392b', Aislado:'#999999', Controvertido:'#b8720b', Promedio:'#2A327B'};

  let lineas = '';
  socio.nominaciones.forEach(nom=>{
    const from = posPorId[nom.estudianteId];
    if(!from) return;
    (nom.positivas||[]).forEach(id=>{
      const to = posPorId[id]; if(!to) return;
      lineas += `<line x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" stroke="#38A935" stroke-width="1.4" opacity="0.55"/>`;
    });
    (nom.negativas||[]).forEach(id=>{
      const to = posPorId[id]; if(!to) return;
      lineas += `<line x1="${from.x}" y1="${from.y}" x2="${to.x}" y2="${to.y}" stroke="#c0392b" stroke-width="1.2" stroke-dasharray="5,4" opacity="0.5"/>`;
    });
  });

  let puntos = '';
  nodos.forEach(al=>{
    const p = posPorId[al.id];
    const est = estatusPorId[al.id] || 'Promedio';
    const color = colorEstatus[est] || '#2A327B';
    puntos += `
      <circle cx="${p.x}" cy="${p.y}" r="17" fill="#fff" stroke="${color}" stroke-width="3.5"><title>${escapeHtml(al.nombre)} — ${est}</title></circle>
      <text x="${p.x}" y="${p.y+4}" text-anchor="middle" font-size="10" font-weight="800" fill="${color}" style="pointer-events:none;">${escapeHtml(iniciales(al.nombre))}</text>
    `;
  });

  return `<svg viewBox="0 0 ${size} ${size}" width="100%" style="max-width:${size}px;display:block;margin:0 auto;">${lineas}${puntos}</svg>`;
}

