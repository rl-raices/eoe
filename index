// Barra horizontal apilada: recibe [{label, value, color}] y dibuja una única
// barra dividida en segmentos proporcionales al valor, con una leyenda debajo
// mostrando el color, la etiqueta y el valor numérico de cada segmento.
function barraProporcional(segments){
  const total = segments.reduce((acc,s)=>acc+(s.value||0), 0);
  if(!total){
    return '<p style="color:var(--text-light);font-size:0.82rem;">Sin datos para graficar todavía.</p>';
  }
  const barras = segments.filter(s=>s.value>0).map(s=>{
    const pct = (s.value/total*100).toFixed(1);
    return `<div style="flex:${s.value} 0 0;background:${s.color};" title="${escapeHtml(s.label)}: ${s.value} (${pct}%)"></div>`;
  }).join('');
  const leyenda = segments.map(s=>`
    <span style="display:inline-flex;align-items:center;gap:5px;margin-right:16px;font-size:0.78rem;color:var(--text);">
      <span style="width:11px;height:11px;border-radius:3px;background:${s.color};display:inline-block;flex-shrink:0;"></span>
      ${escapeHtml(s.label)}: <strong>${s.value}</strong>
    </span>`).join('');
  return `
    <div style="display:flex;height:24px;border-radius:6px;overflow:hidden;background:#eee;margin:10px 0 8px;">${barras}</div>
    <div style="margin-bottom:4px;line-height:1.9;">${leyenda}</div>
  `;
}

// Barra horizontal simple 0-100%: para comparar dos o más porcentajes (por
// ejemplo cohesión vs. disociación grupal) una debajo de la otra.
function barrasPorcentaje(items){
  return items.map(it=>`
    <div style="margin-bottom:8px;">
      <div style="display:flex;justify-content:space-between;font-size:0.78rem;color:var(--text);margin-bottom:3px;">
        <span>${escapeHtml(it.label)}</span><strong>${it.value}%</strong>
      </div>
      <div style="height:14px;border-radius:7px;background:#eee;overflow:hidden;">
        <div style="height:100%;width:${Math.max(0,Math.min(100,it.value))}%;background:${it.color};border-radius:7px;"></div>
      </div>
    </div>
  `).join('');
}

