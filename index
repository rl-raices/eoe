function normalizarClaveEstudiante(s){ return (s||'').trim().toLowerCase().replace(/\s+/g,' '); }

// Integrar respaldo: a diferencia de "Importar respaldo" (que REEMPLAZA todo), esta función
// SUMA a los datos que ya están en esta computadora los estudiantes, tomas de sociograma,
// encuestas de clima y carreras del archivo que todavía no estén acá (comparando por id, que
// es único por diseño: incluye la fecha/hora y un valor aleatorio, así que dos registros
// creados en computadoras distintas nunca comparten id). No borra ni pisa nada de lo existente.
// Pensada para el caso de varias computadoras (una por nivel): permite juntar en una sola
// computadora "maestra" la información cargada en cada una, sin perder nada en el camino.
function integrarRespaldo(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    let data;
    try{ data = JSON.parse(e.target.result); }
    catch(err){ toast('El archivo no es un respaldo JSON válido.'); return; }
    if(!data.estudiantes || !data.config){ toast('El archivo no tiene el formato esperado.'); return; }
    confirmar(
      'Integrar respaldo',
      'Esto agrega a esta computadora los estudiantes, tomas de sociograma, encuestas de clima y carreras del archivo elegido que todavía no estén cargados acá. No se borra ni se reemplaza nada de lo que ya existe en esta computadora. Si el sistema detecta un posible estudiante duplicado (mismo nombre y legajo, cargado por separado en dos computadoras), te lo va a avisar al final para que lo revises vos misma en "Estudiantes". ¿Confirmás integrar este archivo?',
      async ()=>{
        const agregados = { estudiantes:0, sociogramas:0, climaEncuestas:0, carreras:0 };

        const idsEst = new Set(AppState.estudiantes.map(a=>a.id));
        (data.estudiantes||[]).forEach(al=>{
          if(!idsEst.has(al.id)){ AppState.estudiantes.push(al); idsEst.add(al.id); agregados.estudiantes++; }
        });

        const idsSocio = new Set(AppState.sociogramas.map(s=>s.id));
        (data.sociogramas||[]).forEach(s=>{
          if(!idsSocio.has(s.id)){ AppState.sociogramas.push(s); idsSocio.add(s.id); agregados.sociogramas++; }
        });

        const idsClima = new Set(AppState.climaEncuestas.map(c=>c.id));
        (data.climaEncuestas||[]).forEach(c=>{
          if(!idsClima.has(c.id)){ AppState.climaEncuestas.push(c); idsClima.add(c.id); agregados.climaEncuestas++; }
        });

        // Para carreras se compara por NOMBRE además de por id: la lista de carreras por
        // defecto se genera de nuevo (con ids nuevos) la primera vez que se abre la app en
        // cada computadora, así que dos computadoras distintas tienen las mismas ~90 carreras
        // por defecto pero con ids diferentes. Si comparáramos solo por id, cada integración
        // duplicaría todo el catálogo por defecto. Comparando por nombre, solo se agregan
        // carreras realmente nuevas (agregadas a mano en alguna de las computadoras).
        const idsCarr = new Set(AppState.carreras.map(c=>c.id));
        const nombresCarr = new Set(AppState.carreras.map(c=>normalizarClaveEstudiante(c.nombre)));
        (data.carreras||[]).forEach(c=>{
          const claveNombre = normalizarClaveEstudiante(c.nombre);
          if(!idsCarr.has(c.id) && !nombresCarr.has(claveNombre)){
            AppState.carreras.push(c); idsCarr.add(c.id); nombresCarr.add(claveNombre); agregados.carreras++;
          }
        });

        // dbPut es idempotente para los registros que ya existían (los vuelve a guardar
        // igual); solo agrega efectivamente los que son nuevos.
        for(const al of AppState.estudiantes) await dbPut('estudiantes', al);
        for(const s of AppState.sociogramas) await dbPut('sociogramas', s);
        for(const c of AppState.climaEncuestas) await dbPut('climaEncuestas', c);
        for(const car of AppState.carreras) await dbPut('carreras', car);

        // Posibles duplicados: mismo nombre + legajo, pero con id distinto (o sea, se
        // cargaron por separado en dos computadoras en vez de ser el mismo registro).
        const vistos = new Map();
        AppState.estudiantes.forEach(al=>{
          const clave = normalizarClaveEstudiante(al.nombre) + '||' + normalizarClaveEstudiante(al.legajo);
          if(!vistos.has(clave)) vistos.set(clave, []);
          vistos.get(clave).push(al);
        });
        const duplicados = [...vistos.values()].filter(arr=>arr.length>1);

        AppState.config.ultimoRespaldo = new Date().toISOString();
        await guardarConfig();

        currentStudentId = null;
        renderizarListaAlumnos();
        renderBackupBanner();
        filtroNivelInicio = null;
        irASeccion('config');

        let msg = `Integración completa. Se agregaron ${agregados.estudiantes} estudiante(s), ${agregados.sociogramas} toma(s) de sociograma, ${agregados.climaEncuestas} encuesta(s) de clima y ${agregados.carreras} carrera(s) nueva(s) que todavía no estaban en esta computadora.`;
        if(duplicados.length){
          msg += ` Atención: hay ${duplicados.length} nombre(s) y legajo(s) que aparecen más de una vez (posibles estudiantes cargados por separado en dos computadoras). Revisalos en "Estudiantes" y, si corresponde, das de baja el registro repetido: ` + duplicados.map(arr=>arr[0].nombre).join(', ') + '.';
        }
        confirmar('Integrar respaldo', msg, ()=>{});
      }
    );
  };
  reader.readAsText(file);
  evt.target.value = '';
}

function importarRespaldo(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e=>{
    let data;
    try{ data = JSON.parse(e.target.result); }
    catch(err){ toast('El archivo no es un respaldo JSON válido.'); return; }
    if(!data.estudiantes || !data.config){ toast('El archivo no tiene el formato esperado.'); return; }
    confirmar('Importar respaldo', 'Esto reemplaza TODOS los datos actuales (estudiantes, sociogramas, encuestas de clima, base de carreras y configuración) por los del archivo importado. ¿Confirmás?', async ()=>{
      await dbClear('estudiantes'); await dbClear('sociogramas'); await dbClear('climaEncuestas'); await dbClear('carreras');
      AppState = { config: data.config, estudiantes: data.estudiantes||[], sociogramas: data.sociogramas||[], climaEncuestas: data.climaEncuestas||[], carreras: (data.carreras&&data.carreras.length)?data.carreras:carrerasPorDefecto() };
      AppState.config.ultimoRespaldo = new Date().toISOString();
      await guardarConfig();
      for(const al of AppState.estudiantes) await dbPut('estudiantes', al);
      for(const s of AppState.sociogramas) await dbPut('sociogramas', s);
      for(const c of AppState.climaEncuestas) await dbPut('climaEncuestas', c);
      for(const car of AppState.carreras) await dbPut('carreras', car);
      toast('Respaldo importado correctamente.');
      currentStudentId = null;
      renderizarListaAlumnos();
      document.querySelector('.topbar-left h1').textContent = AppState.config.colegioNombre;
      renderBackupBanner();
      irASeccion('config');
    });
  };
  reader.readAsText(file);
  evt.target.value = '';
}

