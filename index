        <div class="num-grid">
          ${RIASEC_KEYS.map(k=>`
            <div class="num-field">
              <label>${RIASEC_NOMBRES[k]} (${k}) 0-100</label>
              <input type="number" min="0" max="100" id="h-${k}" value="${h?h[k]:''}" oninput="recalcularDevolucionVoc()">
            </div>`).join('')}
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label>Código de 3 letras (calculado automáticamente)</label>
          <input type="text" id="h-codigo" value="${h?h.codigo:''}" readonly style="background:#f5f6fb;font-weight:700;">
        </div>
        <label class="sidebar-check" style="margin-top:6px;">
          <input type="checkbox" id="h-manual" ${h&&h.devolucionManual?'checked':''} onchange="toggleDevolucionManualVoc()"> Ajustar manualmente la devolución de 3 áreas
        </label>
        <div class="grid-3" style="margin-top:8px;">
          <div class="form-group">
            <label>Sociales</label>
            <input type="number" min="0" max="100" id="h-dev-sociales" value="${h?h.devolucion3Areas.sociales:''}" ${h&&h.devolucionManual?'':'readonly'}>
          </div>
